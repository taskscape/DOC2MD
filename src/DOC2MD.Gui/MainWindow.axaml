<Window x:Class="DOC2MD.Gui.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOC2MD"
        Height="860"
        Width="1280"
        MinHeight="820"
        MinWidth="1080"
        FontFamily="Inter"
        FontSize="14">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid Margin="18,12,20,8"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,56"
        ColumnDefinitions="170,*,150">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton x:Name="SingleFileRadioButton"
                   Content="Single document"
                   IsChecked="True"
                   GroupName="ConversionMode"
                   Margin="0,0,28,0"
                   IsCheckedChanged="ModeChanged" />
      <RadioButton x:Name="FolderRadioButton"
                   Content="Folder"
                   GroupName="ConversionMode"
                   IsCheckedChanged="ModeChanged" />
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Input" VerticalAlignment="Center" />
    <TextBox x:Name="InputTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,8,4" />
    <Button x:Name="BrowseInputButton" Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseInputClick" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" VerticalAlignment="Center" />
    <TextBox x:Name="OutputTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4,8,4" />
    <Button x:Name="BrowseOutputButton" Grid.Row="2" Grid.Column="2" Content="Browse" Click="BrowseOutputClick" />

    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <CheckBox x:Name="RecursiveCheckBox" Content="Recursive" Margin="0,0,28,0" />
      <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing markdown" />
    </StackPanel>
    <Button x:Name="ConvertButton" Grid.Row="3" Grid.Column="2" Content="Convert" Click="ConvertClick" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="PDF processing" VerticalAlignment="Center" />
    <ComboBox x:Name="PdfProcessingComboBox"
              Grid.Row="4"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              MinHeight="34"
              Margin="0,4,0,4"
              SelectionChanged="PdfProcessingChanged">
      <ComboBoxItem Content="local" />
      <ComboBoxItem Content="azure" />
      <ComboBoxItem Content="markitdown" />
    </ComboBox>

    <TextBlock Grid.Row="5" Grid.Column="0" Text="OCR languages" VerticalAlignment="Center" />
    <TextBox x:Name="OcrLanguagesTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="Tessdata" VerticalAlignment="Center" />
    <TextBox x:Name="TessdataTextBox" Grid.Row="6" Grid.Column="1" Margin="0,4,8,4" />
    <Button x:Name="BrowseTessdataButton" Grid.Row="6" Grid.Column="2" Content="Browse" Click="BrowseTessdataClick" />

    <TextBlock Grid.Row="7" Grid.Column="0" Text="Azure endpoint" VerticalAlignment="Center" />
    <TextBox x:Name="AzureEndpointTextBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" />

    <TextBlock Grid.Row="8" Grid.Column="0" Text="Azure key" VerticalAlignment="Top" Margin="0,14,0,0" />
    <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,8" RowDefinitions="Auto,*">
      <TextBox x:Name="AzureKeyTextBox" Grid.Row="0" PasswordChar="●" />
      <TextBox x:Name="LogTextBox"
               Grid.Row="1"
               Margin="0,18,0,0"
               FontFamily="monospace"
               FontSize="12"
               IsReadOnly="True"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               VerticalContentAlignment="Top"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>

    <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,4,0,0" ColumnDefinitions="260,*,150">
      <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Ready" VerticalAlignment="Center" />
      <ProgressBar x:Name="ConversionProgressBar"
                   Grid.Column="1"
                   Minimum="0"
                   Maximum="1"
                   Height="20"
                   Margin="8,0"
                   VerticalAlignment="Center" />
      <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" IsEnabled="False" Click="CancelClick" />
    </Grid>
  </Grid>
</Window>
