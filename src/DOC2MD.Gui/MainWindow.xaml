<Window x:Class="DOC2MD.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOC2MD" Height="860" Width="1280" MinHeight="820" MinWidth="1080"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="18,12,20,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="SingleFileRadioButton" Content="Single document" IsChecked="True" GroupName="ConversionMode" Margin="0,0,28,0" Checked="ModeChanged" />
            <RadioButton x:Name="FolderRadioButton" Content="Folder" GroupName="ConversionMode" Checked="ModeChanged" />
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="Input" />
        <TextBox x:Name="InputTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,8,4" />
        <Button x:Name="BrowseInputButton" Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseInputClick" />

        <Label Grid.Row="2" Grid.Column="0" Content="Output" />
        <TextBox x:Name="OutputTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4,8,4" />
        <Button x:Name="BrowseOutputButton" Grid.Row="2" Grid.Column="2" Content="Browse" Click="BrowseOutputClick" />

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox x:Name="RecursiveCheckBox" Content="Recursive" Margin="0,0,28,0" />
            <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing markdown" />
        </StackPanel>
        <Button x:Name="ConvertButton" Grid.Row="3" Grid.Column="2" Content="Convert" Click="ConvertClick" />

        <Label Grid.Row="4" Grid.Column="0" Content="PDF processing" />
        <ComboBox x:Name="PdfProcessingComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="34" Margin="0,4,0,4" SelectionChanged="PdfProcessingChanged">
            <ComboBoxItem Content="local" />
            <ComboBoxItem Content="azure" />
            <ComboBoxItem Content="markitdown" />
        </ComboBox>

        <Label Grid.Row="5" Grid.Column="0" Content="OCR languages" />
        <TextBox x:Name="OcrLanguagesTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" />

        <Label Grid.Row="6" Grid.Column="0" Content="Tessdata" />
        <TextBox x:Name="TessdataTextBox" Grid.Row="6" Grid.Column="1" Margin="0,4,8,4" />
        <Button x:Name="BrowseTessdataButton" Grid.Row="6" Grid.Column="2" Content="Browse" Click="BrowseTessdataClick" />

        <Label Grid.Row="7" Grid.Column="0" Content="Azure endpoint" />
        <TextBox x:Name="AzureEndpointTextBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4" />

        <Label Grid.Row="8" Grid.Column="0" Content="Azure key" VerticalAlignment="Top" Margin="0,14,0,0" />
        <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <PasswordBox x:Name="AzureKeyPasswordBox" Grid.Row="0" MinHeight="34" Padding="4" />
            <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,18,0,0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        </Grid>

        <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Label x:Name="StatusLabel" Grid.Column="0" Content="Ready" />
            <ProgressBar x:Name="ConversionProgressBar" Grid.Column="1" Minimum="0" Maximum="1" Height="20" Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" IsEnabled="False" Click="CancelClick" />
        </Grid>
    </Grid>
</Window>
